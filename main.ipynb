        "categorical_features = [\n",
        "    'sex', 'smoker', 'alcohol_freq', 'hypertension', 'diabetes',\n",
        "    'copd', 'cardiovascular_disease', 'cancer_history',\n",
        "    'kidney_disease', 'liver_disease', 'arthritis', 'mental_health', 'asthma'\n",
        "]\n",
        "\n",
        "rows = []\n",
        "for f in categorical_features:\n",
        "    vc = df[f].value_counts(dropna=False)\n",
        "    pct = df[f].value_counts(normalize=True, dropna=False) * 100\n",
        "    for val, cnt in vc.items():\n",
        "        label = 'Missing' if pd.isna(val) else str(val)\n",
        "        rows.append({\n",
        "            'Feature': f,\n",
        "            'Kategori': label,\n",
        "            'Jumlah': int(cnt),\n",
        "            'Persentase (%)': round(float(pct[val]), 2)\n",
        "        })\n",
        "\n",
        "cat_summary = pd.DataFrame(rows)\n",
        "display(cat_summary)\n",
        "\n",
        "n_cols = 3\n",
        "n_rows = int(np.ceil(len(categorical_features) / n_cols))\n",
        "fig, axes = plt.subplots(n_rows, n_cols, figsize=(6 * n_cols, 4 * n_rows))\n",
        "axes = axes.flatten()\n",
        "\n",
        "for i, f in enumerate(categorical_features):\n",
        "    vc = df[f].value_counts(dropna=False)\n",
        "    labels = ['Missing' if pd.isna(x) else str(x) for x in vc.index]\n",
        "    sns.barplot(x=labels, y=vc.values, ax=axes[i], hue=labels, palette='viridis', legend=False)\n",
        "    axes[i].set_title(f'Distribusi \"{f}\"', fontsize=12, fontweight='bold')\n",
        "    axes[i].set_ylabel('Jumlah')\n",
        "    axes[i].tick_params(axis='x', rotation=30)\n",
        "    # Anotasi nilai\n",
        "    for j, v in enumerate(vc.values):\n",
        "        axes[i].text(j, v, f'{v:,}', ha='center', va='bottom', fontsize=8)\n",
        "\n",
        "for k in range(len(categorical_features), len(axes)):\n",
        "    axes[k].axis('off')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
