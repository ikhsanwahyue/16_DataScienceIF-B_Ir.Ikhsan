      "source": [
        "numerical_features = [\n",
        "    'age', 'bmi', 'systolic_bp', 'diastolic_bp', 'ldl', 'hba1c',\n",
        "    'visits_last_year', 'medication_count', 'chronic_count', 'hospitalizations_last_3yrs',\n",
        "    'days_hospitalized_last_3yrs', 'proc_imaging_count', 'proc_surgery_count', 'proc_physio_count',\n",
        "    'proc_consult_count', 'proc_lab_count'\n",
        "]\n",
        "\n",
        "summary_num = df[numerical_features].describe().T[['count', 'mean', 'std', 'min', '25%', '50%', '75%', 'max']]\n",
        "summary_num = summary_num.round(2).reset_index().rename(columns={'index': 'Feature'})\n",
        "display(summary_num)\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(16, 7))\n",
        "\n",
        "summary_num.set_index('Feature')['mean'].sort_values().plot(\n",
        "    kind='barh', ax=axes[0], color='steelblue', edgecolor='black'\n",
        ")\n",
        "axes[0].set_title('Rata-rata (Mean) per Fitur Numerik', fontsize=14, fontweight='bold')\n",
        "axes[0].set_xlabel('Mean')\n",
        "axes[0].grid(axis='x', linestyle='--', alpha=0.7)\n",
        "\n",
        "summary_num.set_index('Feature')[['mean', '50%']].sort_values('mean').plot(\n",
        "    kind='barh', ax=axes[1], color=['steelblue', 'orange'], edgecolor='black'\n",
        ")\n",
        "axes[1].set_title('Mean vs Median per Fitur Numerik', fontsize=14, fontweight='bold')\n",
        "axes[1].set_xlabel('Nilai')\n",
        "axes[1].legend(['Mean', 'Median'])\n",
        "axes[1].grid(axis='x', linestyle='--', alpha=0.7)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n"
      ]
    },
